        velocityY = 570;

        jumping = true;

    }

}


/*
SPACE / UP ARROW
*/

document.addEventListener(
    "keydown",
    function (event) {

        if (
            raidGameOverlay.style.display !== "flex"
        ) {
            return;
        }

        if (
            event.code === "Space" ||
            event.code === "ArrowUp"
        ) {

            event.preventDefault();

            jumpPlayer();

        }

    }
);


/*
CLICK / TAP GAME
*/

gameArea.addEventListener(
    "pointerdown",
    function (event) {

        if (
            event.target.closest(
                "#gameMessage button"
            )
        ) {
            return;
        }

        jumpPlayer();

    }
);


/*
GAME LOOP
*/

function gameLoop(timestamp) {

    if (!gameRunning) {
        return;
    }

    const delta =
        Math.min(
            (timestamp - lastFrame) / 1000,
            0.05
        );

    lastFrame = timestamp;


    /*
    TIMER
    */

    gameTime -= delta;

    if (gameTime < 0) {
        gameTime = 0;
    }

    gameTimerDisplay.textContent =
        gameTime.toFixed(1);


    /*
    GRAVITY
    */

    velocityY -= 1500 * delta;

    playerY += velocityY * delta;

    if (playerY <= 0) {

        playerY = 0;

        velocityY = 0;

        jumping = false;

    }

    gamePlayer.style.bottom =
        (55 + playerY) + "px";


    /*
    SPAWN MECHANICS
    */

    obstacleTimer -= delta;

    if (obstacleTimer <= 0) {

        spawnGameObject();

        /*
        Between roughly 0.8 and 1.4 seconds
        */

        obstacleTimer =
            0.8 + Math.random() * 0.6;

    }


    /*
    MOVE MECHANICS
    */

    updateGameObjects(delta);


    /*
    WIN CONDITION
    */

    if (gameTime <= 0) {

        raidVictory();

        return;

    }


    gameAnimation =
        requestAnimationFrame(gameLoop);

}


/*
SPAWN RANDOM MECHANIC
*/

function spawnGameObject() {

    const random =
        Math.random();

    let object;

    /*
    55% FIRE
    */

    if (random < 0.55) {

        object =
            document.createElement("div");

        object.className =
            "game-fire";

        object.dataset.type =
            "fire";

    }

    /*
    30% ROCK / OBSTACLE
    */

    else if (random < 0.85) {

        object =
            document.createElement("div");

        object.className =
            "game-obstacle";

        object.dataset.type =
            "obstacle";

    }

    /*
    15% PROJECTILE
    */

    else {

        object =
            document.createElement("div");

        object.className =
            "game-projectile";

        object.dataset.type =
            "projectile";

        object.style.bottom =
            (115 + Math.random() * 70) + "px";

    }


    object.style.left =
        gameArea.clientWidth + "px";


    gameArea.appendChild(object);


    gameObjects.push({

        element: object,

        x: gameArea.clientWidth,

        speed:
            280 + Math.random() * 80

    });

}


/*
MOVE OBJECTS AND COLLISION
*/

function updateGameObjects(delta) {

    const playerRect =
        gamePlayer.getBoundingClientRect();


    for (
        let i = gameObjects.length - 1;
        i >= 0;
        i--
    ) {

        const object =
            gameObjects[i];

        object.x -=
            object.speed * delta;

        object.element.style.left =
            object.x + "px";


        /*
        COLLISION
        */

        const objectRect =
            object.element.getBoundingClientRect();


        if (
            !invulnerable &&
            rectanglesOverlap(
                playerRect,
                objectRect
            )
        ) {

            playerHit();

            object.element.remove();

            gameObjects.splice(i, 1);

            continue;

        }


        /*
        REMOVE OFF SCREEN
        */

        if (object.x < -100) {

            object.element.remove();

            gameObjects.splice(i, 1);

        }

    }

}


/*
COLLISION CHECK
*/

function rectanglesOverlap(a, b) {

    /*
    Slightly smaller hitbox to make
    the game feel less unfair
    */

    const padding = 7;

    return !(
        a.right - padding < b.left + padding ||
        a.left + padding > b.right - padding ||
        a.bottom - padding < b.top + padding ||
        a.top + padding > b.bottom - padding
    );

}


/*
PLAYER HIT
*/

function playerHit() {

    if (invulnerable) {
        return;
    }

    gameHealth--;

    invulnerable = true;

    gamePlayer.classList.add(
        "game-hit"
    );


    /*
    UPDATE HEARTS
    */

    if (gameHealth === 2) {

        gameHealthDisplay.textContent =
            "❤ ❤ ♡";

    }

    else if (gameHealth === 1) {

        gameHealthDisplay.textContent =
            "❤ ♡ ♡";

    }

    else {

        gameHealthDisplay.textContent =
            "♡ ♡ ♡";

    }


    /*
    DEATH
    */

    if (gameHealth <= 0) {

        raidDeath();

        return;

    }


    /*
    SHORT INVULNERABILITY
    */

    setTimeout(
        function () {

            invulnerable = false;

            gamePlayer.classList.remove(
                "game-hit"
            );

        },
        700
    );

}


/*
DEATH
*/

function raidDeath() {

    endGameLoop();

    gameMessage.style.display =
        "flex";

    gameMessage.innerHTML = `
        <h2 style="color:#d05245;">
            ☠ ROKS IS DEAD AGAIN
        </h2>

        <p>
            Raid readiness assessment failed.<br><br>

            Cause of death:
            <strong>avoidable mechanic</strong>.<br>

            Roks maintains that it
            "looked safe".
        </p>

        <button id="restartRaidGame">
            RELEASE SPIRIT & TRY AGAIN
        </button>
    `;


    document
        .getElementById("restartRaidGame")
        .addEventListener(
            "click",
            beginRaidGame
        );

}


/*
VICTORY
*/

function raidVictory() {

    endGameLoop();

    gameMessage.style.display =
        "flex";

    gameMessage.innerHTML = `
        <h2 style="color:#d7a94b;">
            🏆 RAID DEFEATED
        </h2>

        <p>
            You survived the encounter.<br><br>

            <strong>
                Good job Chris!
            </strong>

            <br><br>

            Everyone else also participated.
        </p>

        <button id="restartRaidGame">
            TEST AGAIN
        </button>
    `;


    document
        .getElementById("restartRaidGame")
        .addEventListener(
            "click",
            beginRaidGame
        );

}


/*
STOP GAME
*/

function endGameLoop() {

    gameRunning = false;

    if (gameAnimation) {

        cancelAnimationFrame(
            gameAnimation
        );

    }

}


/*
CLEAR OBJECTS
*/

function clearGameObjects() {

    gameObjects.forEach(
        object => {

            object.element.remove();

        }
    );

    gameObjects = [];

}

</script>


