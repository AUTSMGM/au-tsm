    <style>

/* =========================================
   RAID READY MINI GAME
========================================= */

#raidGameOverlay {
    position: fixed;
    inset: 0;

    background: rgba(0, 0, 0, 0.88);

    z-index: 5000;

    display: none;

    align-items: center;
    justify-content: center;

    padding: 20px;
}

.raid-game-window {
    width: min(900px, 100%);

    background: #11100e;

    border: 2px solid #806039;

    box-shadow:
        0 0 0 1px #241d16,
        0 20px 70px rgba(0,0,0,0.8);
}

.game-header {
    display: flex;

    justify-content: space-between;
    align-items: center;

    padding: 18px 20px;

    border-bottom: 1px solid #493a2b;

    background: #191612;
}

.game-header h3 {
    font-family: Georgia, serif;

    color: #d7a94b;

    margin-bottom: 4px;
}

.game-header p {
    color: #746c61;

    font-size: 11px;

    text-transform: uppercase;

    letter-spacing: 1px;
}

#closeRaidGame {
    width: 42px;
    height: 42px;

    background: #221d18;

    border: 1px solid #514235;

    color: #bbb1a4;

    font-size: 17px;
}

#closeRaidGame:hover {
    border-color: #b38538;
}

.game-hud {
    display: flex;

    justify-content: space-between;

    padding: 12px 20px;

    background: #0c0b0a;

    color: #9d9386;

    font-size: 12px;

    letter-spacing: 1px;
}

#gameHealth {
    color: #d9534f;

    margin-left: 6px;
}

#gameTimer {
    color: #d7a94b;

    font-weight: bold;
}

#gameArea {
    height: 360px;

    position: relative;

    overflow: hidden;

    background:
        radial-gradient(circle at 70% 30%, rgba(130,55,25,.18), transparent 35%),
        linear-gradient(#171617, #0b0b0b);

    cursor: pointer;
}

/* dungeon floor */

#gameGround {
    position: absolute;

    left: 0;
    right: 0;
    bottom: 0;

    height: 55px;

    background:
        repeating-linear-gradient(
            90deg,
            #22201c 0px,
            #22201c 80px,
            #29251f 81px,
            #29251f 84px
        );

    border-top: 2px solid #514435;
}

/* PLAYER */

#gamePlayer {
    position: absolute;

    left: 90px;

    bottom: 55px;

    width: 38px;
    height: 60px;

    z-index: 10;
}

.player-head {
    width: 24px;
    height: 24px;

    margin: auto;

    border-radius: 50%;

    background: #7da25c;

    border: 2px solid #b78c43;
}

.player-body {
    width: 34px;
    height: 35px;

    margin: -1px auto 0;

    background: #612920;

    border: 2px solid #b78c43;

    border-radius: 5px 5px 2px 2px;
}

/* FIRE */

.game-fire {
    position: absolute;

    bottom: 55px;

    width: 55px;
    height: 35px;

    background:
        radial-gradient(
            ellipse at bottom,
            #ffdd34 0%,
            #ff7b00 35%,
            #bd1f0b 70%,
            transparent 72%
        );

    animation: firePulse .35s infinite alternate;
}

@keyframes firePulse {

    from {
        transform: scaleY(.85);
    }

    to {
        transform: scaleY(1.15);
    }

}

/* OBSTACLE */

.game-obstacle {
    position: absolute;

    bottom: 55px;

    width: 35px;
    height: 55px;

    background: #3c3936;

    border: 2px solid #70685e;

    border-radius: 4px;
}

/* PROJECTILE */

.game-projectile {
    position: absolute;

    width: 34px;
    height: 34px;

    border-radius: 50%;

    background: radial-gradient(
        circle,
        #cf70ff,
        #652a82 55%,
        transparent 58%
    );

    box-shadow: 0 0 12px #914cc0;
}

/* DAMAGE EFFECT */

.game-hit {
    animation: gameHitFlash .18s alternate 4;
}

@keyframes gameHitFlash {

    from {
        opacity: 1;
    }

    to {
        opacity: .2;
    }

}

/* START / END MESSAGE */

#gameMessage {
    position: absolute;

    inset: 0;

    z-index: 50;

    background: rgba(5,5,5,.82);

    display: flex;

    flex-direction: column;

    align-items: center;
    justify-content: center;

    text-align: center;

    padding: 30px;
}

#gameMessage h2 {
    font-family: Georgia, serif;

    color: #d7a94b;

    margin-bottom: 15px;

    font-size: 30px;
}

#gameMessage p {
    color: #a69b8d;

    line-height: 1.8;

    margin-bottom: 20px;
}

#gameMessage button {
    padding: 12px 22px;

    background: #b38538;

    border: 1px solid #d7a94b;

    color: #111;

    font-weight: bold;
}

.game-controls {
    padding: 13px 18px;

    background: #151310;

    border-top: 1px solid #40362c;

    color: #837a6f;

    font-size: 11px;

    display: flex;

    justify-content: space-between;

    gap: 20px;
}

.game-controls strong {
    color: #c9b18a;
}

@media (max-width: 600px) {

    #gameArea {
        height: 300px;
    }

    .game-controls {
        flex-direction: column;
        gap: 5px;
    }

}

