            font-size: 34px;
            letter-spacing: 4px;
        }

        .logo p {
            color: #978d7e;
            font-size: 11px;
            letter-spacing: 2px;
            margin-top: 4px;
        }

        nav {
            display: flex;
            gap: 24px;
        }

        nav a {
            text-decoration: none;
            color: #cbc5ba;
            font-size: 13px;
        }

        nav a:hover {
            color: #d7a94b;
        }

        /* =========================
           MAIN
        ========================== */

        main {
            max-width: 1180px;
            margin: auto;
            padding: 30px 20px 80px;
        }

        /* =========================
           HERO
        ========================== */

