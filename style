            text-align: center;
            padding: 80px 20px 90px;
        }

        .eyebrow {
            color: #cc4b3c;

            text-transform: uppercase;

            letter-spacing: 5px;

            font-weight: bold;

            font-size: 12px;

            margin-bottom: 18px;
        }

        .hero h2 {
            font-family: Georgia, serif;

            font-size: clamp(54px, 10vw, 90px);

            letter-spacing: 8px;

            color: #f0e7d6;
        }

        .hero h2 span {
            color: #d7a94b;
        }

        .hero-description {
            max-width: 710px;

            margin: 20px auto 0;

            color: #aaa195;

            line-height: 1.8;

            font-size: 17px;
        }

        .horde-badge {
            display: inline-block;

            margin-top: 25px;

            padding: 8px 17px;

            border: 1px solid #73372f;

            background: rgba(120, 35, 26, 0.15);

            color: #dc7364;

            text-transform: uppercase;

            letter-spacing: 2px;

            font-size: 12px;
        }

        .hero-buttons {
            margin-top: 32px;

            display: flex;

            justify-content: center;

            gap: 12px;

            flex-wrap: wrap;
        }

        button {
            cursor: pointer;
            font: inherit;
        }

        .primary-button,
        .secondary-button {
            padding: 12px 20px;

            border-radius: 4px;

            transition: 0.2s;
        }

        .primary-button {
            background: #b38538;

            color: #0c0b09;

            border: 1px solid #d1a653;

            font-weight: bold;
        }

        .primary-button:hover {
            background: #d1a653;
        }

        .secondary-button {
            background: #181614;

            color: #c9c1b5;

            border: 1px solid #494037;
        }

        .secondary-button:hover {
            border-color: #806b4c;
        }

        /* =========================
           SECTIONS
        ========================== */

        section {
            margin-bottom: 85px;
        }

        .section-title {
            text-align: center;

            margin-bottom: 32px;
        }

        .section-title h3 {
            font-family: Georgia, serif;

            color: #d7a94b;

            font-size: 30px;
        }

        .section-title p {
            margin-top: 8px;

            color: #7f786e;

            font-size: 14px;
        }

        /* =========================
           STATS
        ========================== */

        .stats {
            display: grid;

            grid-template-columns: repeat(4, 1fr);

            gap: 15px;
        }

        .stat {
            padding: 28px 14px;

            text-align: center;

            background: rgba(25, 22, 19, 0.94);

            border: 1px solid #41372d;

            border-radius: 5px;
        }

        .stat-number {
            display: block;

            color: #d7a94b;

            font-size: 38px;

            font-weight: bold;
        }

        .stat-label {
            display: block;

            margin-top: 7px;

            color: #91887b;

            font-size: 11px;

            letter-spacing: 1.5px;

            text-transform: uppercase;
        }

        .stat-subtext {
            display: block;

            color: #605a52;

            font-size: 10px;

            margin-top: 7px;
        }

        /* =========================
           LIVE GUILD STATUS
        ========================== */

        .live-grid {
            display: grid;

            grid-template-columns: repeat(3, 1fr);

            gap: 16px;
        }

        .live-card {
            background: #171513;

            border: 1px solid #3d352d;

            padding: 24px;
        }

        .live-label {
            color: #7c7468;

            text-transform: uppercase;

            letter-spacing: 1.5px;

            font-size: 10px;

            margin-bottom: 8px;
        }

        .live-value {
            color: #d7a94b;

            font-size: 20px;

            font-weight: bold;

            line-height: 1.4;
        }

        .live-note {
            color: #716a60;

            font-size: 11px;

            margin-top: 8px;

            line-height: 1.5;
        }

        /* =========================
           METRICS
        ========================== */

        .metrics {
            display: grid;

            grid-template-columns: repeat(3, 1fr);

            gap: 15px;
        }

        .metric {
            background: #171513;

            border: 1px solid #383129;

            padding: 22px;
        }

        .metric-top {
            display: flex;

            justify-content: space-between;

            margin-bottom: 12px;

            font-size: 13px;
        }

        .metric-name {
            color: #bdb5a8;
        }

        .metric-value {
            color: #d7a94b;
        }

        .bar {
            height: 7px;

            background: #292520;

            overflow: hidden;

            border-radius: 4px;
        }

        .fill {
            height: 100%;

            background: #b38538;
        }

        .metric-note {
            color: #666057;

            margin-top: 10px;

            font-size: 11px;

            line-height: 1.5;
        }

        /* =========================
           CLASSES
        ========================== */

        .classes {
            display: grid;

            grid-template-columns: repeat(3, 1fr);

            gap: 12px;
        }

        .class-card {
            background: #171513;

            border: 1px solid #39322b;

            padding: 20px;

            display: flex;

            align-items: center;

            justify-content: space-between;
        }

        .class-name {
            color: #a59d91;
        }

        .class-count {
            font-size: 25px;

            font-weight: bold;
        }

        .warrior { color: #C79C6E; }

        .paladin { color: #F58CBA; }

        .hunter { color: #ABD473; }

        .rogue { color: #FFF569; }

        .priest { color: #FFFFFF; }

        .shaman { color: #0070DE; }

        .mage { color: #69CCF0; }

        .warlock { color: #9482C9; }

        .druid { color: #FF7D0A; }

        /* =========================
           GUILD INTELLIGENCE FEED
        ========================== */

        .feed {
            max-width: 900px;

            margin: auto;

            background: #121110;

            border: 1px solid #393128;
        }

        .feed-item {
            padding: 14px 18px;

            border-bottom: 1px solid #28231e;

            font-size: 13px;

            color: #aaa195;

            line-height: 1.5;
        }

        .feed-item:last-child {
            border-bottom: 0;
        }

        .feed-time {
            color: #615b53;

            margin-right: 10px;

            font-size: 11px;
        }

        /* =========================
           TOOLS
        ========================== */

        .tools {
            display: grid;

            grid-template-columns: repeat(2, 1fr);

            gap: 18px;
        }

        .tool {
            background: rgba(23, 20, 18, 0.95);

            border: 1px solid #3c342b;

            padding: 28px;
        }

        .tool h4 {
            color: #d7a94b;

            font-size: 18px;

            margin-bottom: 10px;
        }

        .tool p {
            color: #92897c;

            line-height: 1.6;

            font-size: 13px;

            min-height: 42px;
        }

        .tool button {
            margin-top: 18px;

            padding: 10px 15px;

            background: #24201b;

            border: 1px solid #66533c;

            color: #ded6ca;

            border-radius: 3px;
        }

        .tool button:hover {
            border-color: #d7a94b;
        }

        .result {
            margin-top: 14px;

            min-height: 20px;

            color: #d7a94b;

            font-size: 13px;
        }

        /* =========================
           RAID
        ========================== */

        .raid-box {
            max-width: 850px;

            margin: auto;

            border: 1px solid #44372c;

            background: #141210;

            padding: 28px;
        }

        .raid-row {
            display: flex;

            justify-content: space-between;

            gap: 20px;

            border-bottom: 1px solid #292520;

            padding: 11px 0;

            color: #9c9488;

            font-size: 13px;
        }

        .raid-row:last-child {
            border-bottom: 0;
        }

        .warning {
            color: #d05d4e;
        }

        .good {
            color: #8eb875;
        }

        /* =========================
           ANNOUNCEMENTS
        ========================== */

        .announcement {
            max-width: 850px;

            margin: auto;

            background: #181512;

            border-left: 3px solid #b38538;

            padding: 25px 30px;

            color: #aaa195;

            line-height: 1.8;
        }

        .announcement strong {
            color: #dfd4c3;
        }

        .announcement + .announcement {
            margin-top: 14px;
        }

        /* =========================
           FOOTER
        ========================== */

        footer {
            border-top: 1px solid #302a22;

            text-align: center;

            padding: 35px 20px 60px;

            color: #625d55;

            font-size: 11px;

            line-height: 1.8;
        }

        footer strong {
            color: #877966;
        }

        /* =========================
           TOAST
        ========================== */

        #toast {
            position: fixed;

            right: 20px;

            bottom: 20px;

            max-width: 360px;

            background: #171513;

            border: 1px solid #6c573f;

            color: #d9d1c5;

            padding: 15px 18px;

            display: none;

            z-index: 2000;

            box-shadow: 0 12px 35px rgba(0,0,0,0.5);

            font-size: 13px;

            line-height: 1.5;
        }

        /* =========================
           MOBILE
        ========================== */

        @media (max-width: 800px) {

            nav {
                display: none;
            }

            .stats,
            .live-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .metrics,
            .tools {
                grid-template-columns: 1fr;
            }

            .classes {
                grid-template-columns: repeat(2, 1fr);
            }

        }

        @media (max-width: 480px) {

            .stats,
            .live-grid {
                grid-template-columns: 1fr;
            }

            .classes {
                grid-template-columns: 1fr;
            }

            .header-inner {
                justify-content: center;
            }

            .logo {
                text-align: center;
            }

        }

    </style>
</head>


